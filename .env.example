# Book-class API: default is atomic slot-lock (no multi-doc transactions). Standalone MongoDB OK.
# Set to true only on a replica set (e.g. MongoDB Atlas) if you want withTransaction for booking.
# USE_TRANSACTIONS=false

# Optional: WebRTC TURN relay for live classroom video when STUN/P2P fails
# (strict NAT, some mobile networks, or tunnel URLs). Get credentials from your
# provider (e.g. Twilio, Metered, Xirsys) or a self-hosted coturn.
# TURN_URLS=turn:global.turn.twilio.com:3478?transport=udp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional: QA lesson recording (on by default; set false to disable)
# CLASSROOM_QA_RECORDING_ENABLED=false
# CLASSROOM_QA_RECORDING_MAX_MINUTES=25
# Keep recordings 3 days or one week (expiresAt), then delete when expired:
# CLASSROOM_RECORDING_RETENTION_DAYS=7
# Run automated cleanup weekly (not daily); admins can still purge manually anytime:
# CLASSROOM_RECORDING_PURGE_INTERVAL_DAYS=7
# CLASSROOM_RECORDING_MAX_MB=120
