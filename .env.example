PORT=8080
MONGODB_URI=mongodb://localhost:27017/online-distance-learning
JWT_SECRET=replace-with-long-random-secret

# Optional: AES-256-GCM for phone/contact fields (64-char hex, or 32-byte base64, or any string → SHA-256 key).
# When unset, PII stays plaintext. Rotating requires a re-encrypt migration.
# PII_ENCRYPTION_KEY=

# Least-privilege DB user, backups, audit listing: see scripts/mongo/README.md

# --- Admin security ---
# Public URL path segment for the staff sign-in page (8–128 chars, [a-zA-Z0-9_-] only).
# If unset, the server uses a built-in default path (override in production).
ADMIN_LOGIN_PATH=

# First admin bootstrap (plaintext only in .env; stored as bcrypt in MongoDB). Remove or blank after onboarding.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Session cookie signing (use a long random string; should differ from JWT_SECRET in production)
SESSION_SECRET=

# HTTPS only: set true behind TLS. In local HTTP dev, leave unset or false so the session cookie is not Secure.
SESSION_COOKIE_SECURE=false

# Session cookie SameSite (default strict). Use lax for unusual cross-site flows.
# SESSION_COOKIE_SAMESITE=lax

# JWT lifetime (default 1h). Admin session cookie max age matches via SESSION_MAX_AGE_MS unless set separately.
# JWT_EXPIRES_IN=1h
# SESSION_MAX_AGE_MS=3600000

# Student/teacher login lockout after failed password attempts (defaults: 5 attempts, 15 minutes)
# LOGIN_LOCK_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION_MS=900000

# Optional: comma-separated IPs allowed to open the admin login page (e.g. 127.0.0.1,203.0.113.10). Empty = allow all.
ADMIN_IP_WHITELIST=

# Behind reverse proxy: set TRUST_PROXY=1 so ADMIN_IP_WHITELIST uses X-Forwarded-For correctly.
TRUST_PROXY=

# Max attempts per IP per 15 minutes for POST /api/auth/admin-login (default 10)
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Max requests per IP per 15 minutes for all /api/admin/* routes (default 3000)
ADMIN_API_RATE_LIMIT_MAX=3000

EMAIL_SERVICE_TYPE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-app-password

PAYMONGO_SECRET_KEY=YOUR_PAYMONGO_SECRET_KEY
PAYMONGO_PUBLIC_KEY=YOUR_PAYMONGO_PUBLIC_KEY
PAYMONGO_WEBHOOK_SECRET=YOUR_PAYMONGO_WEBHOOK_SECRET

# Reject PayMongo webhook if signature timestamp t is farther than this many seconds from server time (default 300)
# PAYMONGO_WEBHOOK_MAX_SKEW_SEC=300

# API rate limits (optional overrides)
# RATE_LIMIT_LOGIN_MAX_PER_15M=40
# RATE_LIMIT_ADMIN_LOGIN_MAX_PER_15M=
# RATE_LIMIT_PASSWORD_RESET_MAX_PER_HOUR=12
# RATE_LIMIT_REGISTER_MAX_PER_HOUR=25
# RATE_LIMIT_UPLOAD_MAX_PER_15M=120
# RATE_LIMIT_TEACHER_SEARCH_PER_MIN=40

# Machine-only integration auth (use on dedicated routes; never use admin JWT for bots). Min 16 chars when set.
# INTEGRATION_SERVICE_TOKEN=
# Header: X-RemoEd-Service-Token or X-Integration-Token

CLOUDMERSIVE_API_KEY=replace-me

# Optional: booking transaction mode (use true on replica set only)
USE_TRANSACTIONS=false

# Optional: TURN server for WebRTC fallback.
# If STUN is blocked (common on strict Wi‑Fi/ISP), you NEED `turns:` (TCP/TLS 443).
# TURN_URLS=turns:your-turn-host:443?transport=tcp,turn:your-turn-host:3478?transport=tcp
# TURN_USERNAME=turn-username
# TURN_CREDENTIAL=turn-password
