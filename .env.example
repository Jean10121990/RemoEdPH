PORT=8080
MONGODB_URI=mongodb://localhost:27017/online-distance-learning
JWT_SECRET=replace-with-long-random-secret

# --- Admin security ---
# Public URL path segment for the admin login page (8–128 chars, [a-zA-Z0-9_-] only). Example: k9mPx2vqL4nR8wJh
# Dev default if unset: remo-dev-admin-login  (set a secret value in production)
ADMIN_LOGIN_PATH=

# First admin bootstrap (plaintext only in .env; stored as bcrypt in MongoDB). Remove or blank after onboarding.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Session cookie signing (use a long random string; should differ from JWT_SECRET in production)
SESSION_SECRET=

# HTTPS only: set true behind TLS. In local HTTP dev, leave unset or false so the session cookie is not Secure.
SESSION_COOKIE_SECURE=false

# Optional: comma-separated IPs allowed to open the admin login page (e.g. 127.0.0.1,203.0.113.10). Empty = allow all.
ADMIN_IP_WHITELIST=

# Behind reverse proxy: set TRUST_PROXY=1 so ADMIN_IP_WHITELIST uses X-Forwarded-For correctly.
TRUST_PROXY=

# Max attempts per IP per 15 minutes for POST /api/auth/admin-login (default 10)
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Max requests per IP per 15 minutes for all /api/admin/* routes (default 3000)
ADMIN_API_RATE_LIMIT_MAX=3000

EMAIL_SERVICE_TYPE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-app-password

PAYMONGO_SECRET_KEY=YOUR_PAYMONGO_SECRET_KEY
PAYMONGO_PUBLIC_KEY=YOUR_PAYMONGO_PUBLIC_KEY
PAYMONGO_WEBHOOK_SECRET=YOUR_PAYMONGO_WEBHOOK_SECRET

CLOUDMERSIVE_API_KEY=replace-me

# Optional: booking transaction mode (use true on replica set only)
USE_TRANSACTIONS=false

# Optional: TURN server for WebRTC fallback
# TURN_URLS=turn:your-turn-host:3478?transport=udp
# TURN_USERNAME=turn-username
# TURN_CREDENTIAL=turn-password
