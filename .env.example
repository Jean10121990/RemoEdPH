PORT=8080

# --- MongoDB ---
# Remote/server database (MongoDB Atlas or hosted). Used when MONGODB_CONNECTION_MODE=server or as the first try in auto mode.
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/online-distance-learning?retryWrites=true&w=majority

# Local fallback when the server database is unavailable (default: mongodb://localhost:27017/online-distance-learning).
# MONGODB_URI_LOCAL=mongodb://localhost:27017/online-distance-learning

# Connection mode for local dev: auto | server | local
# - auto   (default locally) — try MONGODB_URI first, fall back to MONGODB_URI_LOCAL if server is down
# - server — use MONGODB_URI only (production/Cloud Run default)
# - local  — use MONGODB_URI_LOCAL only (offline localhost testing)
# MONGODB_CONNECTION_MODE=auto

JWT_SECRET=replace-with-long-random-secret

# Browser origin of your deployed app (Hostinger / production). Used for CORS + Socket.IO.
# FRONTEND_URL=https://www.example.com

# Optional: comma-separated extra allowed CORS origins (must be full URLs with scheme for exact match).
# Example: CORS_ORIGINS=http://localhost:5173,https://staging.example.com
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.example.com

# --- Redis (optional; cache-aside for slots / student profile) ---
# If unset, the server defaults to redis://127.0.0.1:6379 (typical local dev).
# On Hostinger with no Redis: set REDIS_DISABLED=1 OR set REDIS_URL= (empty value) so the API never tries to connect.
# REDIS_URL=redis://:password@127.0.0.1:6379
# REDIS_DISABLED=1

# Optional: comma-separated teacher emails for founder career-ladder override (Legacy Guide snapshot). Leave unset so everyone uses calculated growth.
# REMOED_FOUNDER_TEACHER_EMAIL=

# Optional: AES-256-GCM for phone/contact fields (64-char hex, or 32-byte base64, or any string → SHA-256 key).
# When unset, PII stays plaintext. Rotating requires a re-encrypt migration.
# PII_ENCRYPTION_KEY=

# Least-privilege DB user, backups, audit listing: see scripts/mongo/README.md

# --- Admin security ---
# "New device" admin login alerts are sent from this address (must be allowed by your email provider). Default: support@remoedph.com
# REMOED_SECURITY_ALERT_FROM_EMAIL=support@remoedph.com

# Legacy: single-account identifier used by older builds for forced 2FA. All admins with isTwoFactorEnabled off are now required to enroll.
# FORCE_2FA_ADMIN_IDENTIFIER=admin@remoedph.com

# Super-Admin System Monitor: POST /api/admin/system-emergency-pm2-restart runs `pm2 restart <name>`. Set to 0/false to disable exec (UI still loads).
# SUPER_MONITOR_PM2_RESTART_ENABLED=1
# PM2 app name or id (alphanumeric, dot, hyphen, underscore only).
# SUPER_MONITOR_PM2_PROCESS=remoed-1

# Public URL path segment for the staff sign-in page (8–128 chars, [a-zA-Z0-9_-] only).
# If unset, the server uses a built-in default path (override in production).
ADMIN_LOGIN_PATH=

# First admin bootstrap (plaintext only in .env; stored as bcrypt in MongoDB). Remove or blank after onboarding.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Session cookie signing (use a long random string; should differ from JWT_SECRET in production)
SESSION_SECRET=

# HTTPS only: set true behind TLS. In local HTTP dev, leave unset or false so the session cookie is not Secure.
SESSION_COOKIE_SECURE=false

# Session cookie SameSite (default strict). Use lax for unusual cross-site flows.
# SESSION_COOKIE_SAMESITE=lax

# JWT lifetime (default 1h). Admin session cookie max age matches via SESSION_MAX_AGE_MS unless set separately.
# JWT_EXPIRES_IN=1h
# SESSION_MAX_AGE_MS=3600000

# Student/teacher login lockout after failed password attempts (defaults: 5 attempts, 15 minutes)
# LOGIN_LOCK_MAX_ATTEMPTS=5
# LOGIN_LOCK_DURATION_MS=900000

# Optional: separate key for encrypting admin TOTP secrets at rest (defaults to SHA-256 of JWT_SECRET if unset).
# TOTP_ENCRYPTION_KEY=

# Behind reverse proxy (nginx, Cloud Run): set TRUST_PROXY=1 so req.ip and
# express-rate-limit work with X-Forwarded-For. In production (NODE_ENV=production) this is off unless set.
# Set TRUST_PROXY=0 or false for plain localhost (no proxy).
TRUST_PROXY=

# Max attempts per IP per 15 minutes for POST /api/auth/admin-login (default 10)
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Max requests per IP per 15 minutes for all /api/admin/* routes (default 3000)
ADMIN_API_RATE_LIMIT_MAX=3000

# Optional: max JSON body for API (lesson uploads use base64). Default 52mb. Must be ≤ reverse-proxy limit (Nginx client_max_body_size).
# JSON_BODY_LIMIT=52mb

EMAIL_SERVICE_TYPE=smtp
# Hostinger (default in code): smtp.hostinger.com:465 TLS. From header is fixed: RemoEd Support <support@remoedph.com>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# SMTP_SECURE=false if you use port 587 with STARTTLS
# Primary credentials (recommended — matches server/emailService.js)
EMAIL_USER=support@remoedph.com
EMAIL_PASS=replace-with-hostinger-mailbox-password
# Legacy aliases (optional)
# SMTP_USER=support@remoedph.com
# SMTP_PASS=replace-with-app-password

PAYMONGO_SECRET_KEY=YOUR_PAYMONGO_SECRET_KEY
PAYMONGO_PUBLIC_KEY=YOUR_PAYMONGO_PUBLIC_KEY
PAYMONGO_WEBHOOK_SECRET=YOUR_PAYMONGO_WEBHOOK_SECRET

# Reject PayMongo webhook if signature timestamp t is farther than this many seconds from server time (default 300)
# PAYMONGO_WEBHOOK_MAX_SKEW_SEC=300

# API rate limits (optional overrides)
# RATE_LIMIT_LOGIN_MAX_PER_15M=40
# RATE_LIMIT_ADMIN_LOGIN_MAX_PER_15M=
# RATE_LIMIT_PASSWORD_RESET_MAX_PER_HOUR=12
# RATE_LIMIT_REGISTER_MAX_PER_HOUR=25
# RATE_LIMIT_UPLOAD_MAX_PER_15M=120
# RATE_LIMIT_TEACHER_SEARCH_PER_MIN=40

# Machine-only integration auth (use on dedicated routes; never use admin JWT for bots). Min 16 chars when set.
# INTEGRATION_SERVICE_TOKEN=
# Header: X-RemoEd-Service-Token or X-Integration-Token

CLOUDMERSIVE_API_KEY=replace-me

# Optional: booking transaction mode (use true on replica set only)
USE_TRANSACTIONS=false

# Optional: TURN server for WebRTC fallback (live classroom). Use a full turn: or turns: URL.
# TURN_URL=turn:your-turn-host:3478
# TURN_USERNAME=turn-username
# TURN_CREDENTIAL=turn-password
